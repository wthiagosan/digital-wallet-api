# ==============================================================================
# Digital Wallet API - Environment Variables Configuration Template
# Copy this file to '.env' and fill in secure values before deploying to production.
# ==============================================================================

# Database Configuration
POSTGRES_DB=wallet_db
POSTGRES_USER=wallet_user
POSTGRES_PASSWORD=change_this_to_a_strong_password_in_production

# Application Database Connection
DB_HOST=postgres
DB_PORT=5432
DB_NAME=wallet_db
DB_USER=wallet_user
DB_PASS=change_this_to_a_strong_password_in_production

# Security & CORS (comma-separated origins or domain regex)
SECURITY_CORS_ALLOWED_ORIGINS=https://app.wallet.com,https://admin.wallet.com
